{
  "name": "futari",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && cp dist/+not-found.html dist/404.html 2>/dev/null || true",
    "supabase:deploy-functions": "npx supabase functions deploy",
    "supabase:serve-functions": "npx supabase functions serve",
    "setup:email-templates": "node scripts/setup-email-templates.js",
    "test:e2e:web": "npx playwright test",
    "test:e2e:web:ui": "npx playwright test --ui",
    "test:e2e:web:headed": "npx playwright test --headed",
    "test:e2e:mobile": "npx detox test",
    "test:e2e:mobile:ios": "npx detox test --configuration ios",
    "test:e2e:mobile:android": "npx detox test --configuration android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~54.0.31",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "supabase": "^2.15.0",
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.48.0",
    "detox": "^20.20.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "dotenv": "^16.4.5"
  },
  "private": true
}
